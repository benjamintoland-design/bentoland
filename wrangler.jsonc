{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bentoland-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "bentoland-photos"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bentoland-db"
    }
  ]
}
